# ============================================================
# 本地开发专用(docker-compose.dev.yml),可提交仓库
# 严禁用于任何部署环境;生产密钥走 deploy/.env(.gitignore)
# ============================================================

# 数据库 / 队列 / 存储(仅本机 dev 卷有效)
PG_PASSWORD=dev_pg_password
REDIS_PASSWORD=dev_redis_password
JWT_SECRET=dev_jwt_secret_not_for_production

MINIO_ROOT_USER=devroot
MINIO_ROOT_PASSWORD=devroot123
MINIO_APP_USER=cdap-app
MINIO_APP_PASSWORD=cdapapp123

# 网络受限时覆盖为国内镜像源,如 https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_INDEX_URL=

# LLM(T6.6 落地后生效):
# - 用本机 Windows 上装的 Ollama:默认即可(容器经 host.docker.internal 访问宿主机)
# - 用服务器上的 Ollama:改成 http://<服务器IP>:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
