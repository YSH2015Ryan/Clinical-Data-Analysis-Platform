# 复制为 deploy/.env 并填入随机值；.env 已被 .gitignore 屏蔽
PG_PASSWORD=change-me-random
REDIS_PASSWORD=change-me-random
MINIO_ROOT_USER=cdap-admin
MINIO_ROOT_PASSWORD=change-me-random
MINIO_APP_USER=cdap-storage
MINIO_APP_PASSWORD=change-me-random
JWT_SECRET=change-me-random-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=prod
LOG_LEVEL=INFO
# 上传文件大小上限（MB，默认 200；修改时需同步调整前端预检和 frontend/nginx.conf）
MAX_UPLOAD_MB=200
# 公网域名：Caddy 自动申请并续期 HTTPS 证书；STORAGE_DOMAIN 只暴露 S3 API
PUBLIC_DOMAIN=cdap.example.com
STORAGE_DOMAIN=storage.cdap.example.com
# 网络受限环境（国内）建议：
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- LLM 部署层（T6.6；运行层策略/开关/key 由管理员在「AI 设置」页调整，勿在此配置）----
# Ollama 服务地址：与后端同机 compose 部署填 http://ollama:11434；挂宿主机填 http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_MODEL=gpt-4o-mini
# 云端总闸：true 才允许使用云端 LLM（医疗机构默认 false）
LLM_CLOUD_ENABLED=false
# 默认模型策略（auto=本地优先降级云端 / local / cloud），可被「AI 设置」页运行层配置覆盖
LLM_DEFAULT_CHOICE=auto
# admin_settings 敏感字段 Fernet 密钥（python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
SETTINGS_ENCRYPTION_KEY=change-me-fernet-key
