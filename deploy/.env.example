# 复制为 deploy/.env 并填入随机值；.env 已被 .gitignore 屏蔽
PG_PASSWORD=change-me-random
MINIO_ROOT_USER=cdap-admin
MINIO_ROOT_PASSWORD=change-me-random
JWT_SECRET=change-me-random-64-chars
LOG_LEVEL=INFO
# 上传文件大小上限（MB，默认 200；Nginx 前置上限 1024MB，超过需同步改 frontend/nginx.conf）
MAX_UPLOAD_MB=200
# 网络受限环境（国内）建议：
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
