<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<title>临床数据分析报告</title>
<style>
  /* 排版取向：医学科研期刊（docs/10 §2.1，IMRaD + TRIPOD 顺序，NEJM/Lancet/JAMA 惯例）——
     正文衬线、标题无衬线深色、三线表、表题表上/图题图下、页眉短标题 + 页脚页码 */
  @page { size: A4; margin: 2.4cm 2.1cm;
          @top-center { content: "临床数据分析报告"; font-size: 8.5px; color: #999;
                        letter-spacing: 1px; font-family: "Noto Sans CJK SC", sans-serif; }
          @bottom-center { content: "第 " counter(page) " 页 / 共 " counter(pages) " 页";
                           font-size: 9px; color: #888;
                           font-family: "Noto Sans CJK SC", sans-serif; } }
  @page :first { @top-center { content: none; } }
  body { font-family: "Noto Serif CJK SC", "Noto Sans CJK SC", "Microsoft YaHei", serif;
         color: #1a1a1a; max-width: 760px; margin: 0 auto; padding: 24px;
         line-height: 1.8; font-size: 12.5px; text-align: justify; }
  h1 { font-family: "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
       font-size: 21px; text-align: center; letter-spacing: 1px;
       border-bottom: 2px solid #1a1a1a; padding-bottom: 12px; margin-bottom: 6px; }
  h2 { font-family: "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
       font-size: 15px; color: #1a1a1a; border-bottom: 1px solid #999;
       padding-bottom: 4px; margin-top: 26px; }
  .meta { color: #666; font-size: 11px; text-align: center; }
  .abstract { background: #f7f7f5; border: 1px solid #ddd; border-left: 4px solid #1a1a1a;
              padding: 12px 16px; margin: 18px 0 6px; }
  .abstract p { margin: 4px 0; }
  .abs-title { font-family: "Noto Sans CJK SC", sans-serif; font-weight: bold;
               letter-spacing: 3px; margin: 0 0 6px; }
  .abs-label { font-weight: bold; font-family: "Noto Sans CJK SC", sans-serif; }
  .part { font-family: "Noto Sans CJK SC", sans-serif; font-size: 12px; color: #555;
          letter-spacing: 4px; border-bottom: 1.5px solid #333; padding-bottom: 3px;
          margin: 36px 0 0; }
  table { border-collapse: collapse; width: 100%; margin: 10px 0 16px; font-size: 12px;
          border-top: 1.5px solid #333; border-bottom: 1.5px solid #333; }
  th, td { border: none; padding: 5px 8px; text-align: left; }
  th { font-family: "Noto Sans CJK SC", sans-serif; border-bottom: 1px solid #666; }
  caption { caption-side: top; text-align: left; font-size: 11px; font-weight: bold;
            color: #333; padding: 4px 0; font-family: "Noto Sans CJK SC", sans-serif; }
  /* HTML 交互折叠（docs/10 §2.2）：无 JS 依赖，sandbox iframe 内可用 */
  details.fold { margin: 10px 0 16px; }
  details.fold > summary { cursor: pointer; list-style: none; font-size: 11px;
        font-weight: bold; color: #333; padding: 4px 0;
        font-family: "Noto Sans CJK SC", sans-serif; }
  details.fold > summary::-webkit-details-marker { display: none; }
  details.fold > summary::before { content: "＋ "; color: #888; }
  details.fold[open] > summary::before { content: "－ "; color: #888; }
  details.fold > table { margin: 6px 0 4px; }
  .na { color: #999; font-style: italic; }
  .red-flag { border: 2px solid #b3001b; background: #fdf3f4; color: #7a0012;
              padding: 10px 14px; font-weight: bold; line-height: 1.8; text-align: justify; }
  .notice { background: #fafafa; border-left: 3px solid #999; padding: 8px 12px; font-size: 12px; }
  .llm-paragraph { background: #f5f7fa; border-left: 3px solid #7a9cc6; padding: 8px 12px;
                   text-align: justify; line-height: 1.8; }
  .guide { background: #fbfbf8; border: 1px solid #ddd; padding: 8px 12px; margin: 10px 0;
           line-height: 1.8; text-align: justify; }
  .guide p { margin: 4px 0; }
  .disclaimer { border-top: 1.5px solid #333; border-bottom: 1.5px solid #333; padding: 10px 4px;
                font-weight: bold; margin-top: 20px; text-align: center; }
  /* P0-10/P0-12（updateplan §69/§70）：状态灯横幅；RED 时首页醒目展示固定 Scope of Use */
  .status-banner { padding: 10px 14px; margin: 14px 0 4px; line-height: 1.7; text-align: left;
                   border: 1px solid #ccc; font-size: 12.5px; }
  .status-banner ul { margin: 6px 0 0; padding-left: 20px; }
  .status-banner .scope { font-size: 11.5px; font-weight: normal; margin: 8px 0 0;
                          border-top: 1px dashed #b3001b; padding-top: 8px; }
  .status-red { border: 2.5px solid #b3001b; background: #fdf3f4; color: #7a0012;
                font-weight: bold; }
  .status-yellow { border: 2px solid #d48806; background: #fffbe6; color: #613400;
                   font-weight: bold; }
  .status-green { border: 1px solid #389e0d; background: #f6ffed; color: #135200;
                  font-weight: bold; }
  img.chart { max-width: 100%; display: block; margin: 12px auto 0; }
  .fig-caption { font-size: 11px; color: #444; line-height: 1.6;
                 margin: 4px 0 18px; text-align: justify; }
  .fig-label { font-weight: bold; color: #1a1a1a; font-family: "Noto Sans CJK SC", sans-serif; }
</style>
</head>
<body>
{# 表题宏：全文连续编号（docs/10 §2.1 表题表上）；collapsible 时默认折叠（§2.2） #}
{% set T = namespace(n=0) %}
{% macro tbl(title) -%}
  {% set T.n = T.n + 1 -%}
  {% if collapsible -%}
<details class="fold"><summary>表 {{ T.n }} {{ title }}</summary>
<table>
{{ caller() }}</table>
</details>
  {%- else -%}
<table>
  <caption>表 {{ T.n }} {{ title }}</caption>
{{ caller() }}</table>
  {%- endif -%}
{%- endmacro %}

<h1>临床数据分析报告</h1>
<p class="meta">
  数据集：{{ dataset.name or "—" }} ｜ 任务类型：{{ task_label or run.task_type or "—" }} ｜
  运行时间：{{ run.created_at or "—" }}
</p>

{# P0-10/P0-12（updateplan §69/§70）：状态灯由规则系统判定；RED 时首页醒目横幅含固定 Scope of Use 声明（非 LLM 生成，不得改写） #}
{% if analysis_status %}
<div class="status-banner status-{{ analysis_status.level | lower }}">
  分析状态：{{ analysis_status.level }} —— {{ analysis_status.label }}
  {% if analysis_status.reasons %}
  <ul>
    {% for reason in analysis_status.reasons %}
    <li>{{ reason }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if analysis_status.scope_banner %}
  <p class="scope">{{ analysis_status.scope_of_use }}</p>
  {% endif %}
  {# §72：探索性模式固定声明（verbatim，不得改写） #}
  {% if analysis_status.exploratory_statement %}
  <p class="scope">{{ analysis_status.exploratory_statement }}</p>
  {% endif %}
</div>
{% endif %}

{% if abstract %}
<div class="abstract">
  <p class="abs-title">摘　要</p>
  {% if abstract.purpose %}<p><span class="abs-label">目的：</span>{{ abstract.purpose }}</p>{% endif %}
  {% if abstract.methods %}<p><span class="abs-label">方法：</span>{{ abstract.methods }}</p>{% endif %}
  {% if abstract.results %}<p><span class="abs-label">结果：</span>{{ abstract.results }}</p>{% endif %}
  {% if abstract.conclusion %}<p><span class="abs-label">结论：</span>{{ abstract.conclusion }}</p>{% endif %}
</div>
{% endif %}

{% for s in sections %}
{% if s.key == "overview" %}<p class="part">研 究 方 法</p>{% endif %}
{% if s.key == "performance" %}<p class="part">研 究 结 果</p>{% endif %}
{% if s.key == "clinical_interpretation" %}<p class="part">讨　　论</p>{% endif %}
<h2>{{ s.title }}</h2>
{% if not s.applicable %}
<p class="na">{{ s.data.note }}</p>

{% elif s.key == "overview" %}
<p>样本量：{{ s.data.n_samples }}；变量数：{{ s.data.n_features }}。
{% if s.data.get('prevalence') is not none %}阳性 {{ s.data.positives }} 例（阳性率 {{ '%.2f%%' | format(s.data.prevalence * 100) }}）。{% endif %}
{% if s.data.get('n_classes') is not none and s.data.n_classes > 2 %}多分类（{{ s.data.n_classes }} 类）。{% endif %}
{% if s.data.events is defined and s.data.events is not none %}事件数：{{ s.data.events }}；中位随访时间：{{ s.data.median_followup }}。{% endif %}</p>
{% if s.data.columns %}
{% call tbl("变量概况") %}
  <tr><th>变量</th><th>类型</th><th>缺失率</th><th>唯一值</th><th>最小值</th><th>最大值</th></tr>
  {% for c in s.data.columns %}
  <tr><td>{{ c.name }}</td><td>{{ c.inferred_type }}</td>
      <td>{{ '%.1f%%' | format(c.missing_rate * 100) }}</td><td>{{ c.unique }}</td>
      <td>{{ c.min if c.min is not none else "—" }}</td>
      <td>{{ c.max if c.max is not none else "—" }}</td></tr>
  {% endfor %}
{% endcall %}
{% endif %}
{% if s.data.baseline_table %}
{% set bt = s.data.baseline_table %}
{% call tbl("基线特征表") %}
  <tr><th>特征</th><th>总体 (N={{ bt.total_n }})</th>
    {% for st in bt.strata %}{% if st.name != "Total" %}<th>{{ st.name }} (N={{ st.n }})</th>{% endif %}{% endfor %}
    {% if bt.strata | length > 1 %}<th>p 值</th><th>校正后 p 值</th>{% endif %}</tr>
  {% for r in bt.rows %}
  {% if r.type == "categorical_header" %}
  <tr><td><strong>{{ r.variable }}</strong></td><td></td>
    {% for st in bt.strata %}{% if st.name != "Total" %}<td></td>{% endif %}{% endfor %}
    {% if bt.strata | length > 1 %}<td></td><td></td>{% endif %}</tr>
  {% else %}
  <tr><td>{{ r.variable }}</td><td>{{ r.total or "—" }}</td>
    {% for st in bt.strata %}{% if st.name != "Total" %}<td>{{ r["stratum_" ~ st.name] or "—" }}</td>{% endif %}{% endfor %}
    {% if bt.strata | length > 1 %}<td>{{ r.p_value_text or "" }}</td><td>{{ r.p_adjusted_text or "" }}</td>{% endif %}</tr>
  {% endif %}
  {% endfor %}
{% endcall %}
{% if bt.note %}<p class="meta">{{ bt.note }}</p>{% endif %}
{% endif %}
{% if s.data.eda_summary %}
<p><strong>数据体检摘要（上传后自动产出）：</strong></p>
<ul>{% for line in s.data.eda_summary %}<li>{{ line }}</li>{% endfor %}</ul>
{% endif %}
{% if s.data.screening %}
{% set sc = s.data.screening %}
{% call tbl("单因素筛选（按 p 值升序" ~ ("，前 " ~ (sc.rows | length) ~ "/" ~ sc.n_total_tested ~ " 项" if sc.n_total_tested and sc.n_total_tested > (sc.rows | length) else "") ~ "）") %}
  <tr><th>变量</th><th>检验</th><th>效应量</th><th>p 值</th><th>校正后 p 值</th><th>入选</th></tr>
  {% for r in sc.rows %}
  <tr><td>{{ r.feature }}</td><td>{{ r.test }}</td>
      <td>{{ r.effect | fmt_num('.4g') }}</td>
      <td>{{ r.p_value | fmt_num }}</td>
      <td>{{ (r.p_adjusted if r.p_adjusted is not none else r.p_value) | fmt_num }}</td>
      <td>{{ "是" if r.selected else "否" }}</td></tr>
  {% endfor %}
{% endcall %}
{# §30：显著性结论必须基于校正后 p 值并注明校正方法与检验总数 #}
<p class="meta">单因素筛选阈值 α={{ sc.alpha }}：入选判定基于{{ sc.correction_label or "Benjamini–Hochberg(FDR)" }}校正后 p 值（共 {{ sc.n_tests or (sc.rows | length) }} 项检验），{{ sc.selected_features | length }} 个变量入选，供多因素建模参考；单因素显著性不构成因果结论。</p>
{% if sc.correction_warning %}<p class="meta" style="color:#b3001b;font-weight:bold;">⚠ {{ sc.correction_warning }}</p>{% endif %}
{% endif %}

{% elif s.key == "quality" %}
<p>校验结论：{{ s.data.status }}（阻塞 {{ s.data.blockers }} 项，警告 {{ s.data.warnings }} 项）。</p>
{% if s.data.issues %}
{% call tbl("数据质量问题清单") %}
  <tr><th>级别</th><th>列</th><th>问题</th><th>建议</th></tr>
  {% for i in s.data.issues %}
  <tr><td>{{ i.severity }}</td><td>{{ i.column or "—" }}</td>
      <td>{{ i.message }}</td><td>{{ i.suggestion }}</td></tr>
  {% endfor %}
{% endcall %}
{% endif %}
{% if s.data.transform_log %}
{% call tbl("数据处理动作") %}
  <tr><th>动作</th><th>列</th><th>影响行数</th></tr>
  {% for t in s.data.transform_log %}
  <tr><td>{{ t.action }}</td><td>{{ t.column or "—" }}</td><td>{{ t.affected_rows }}</td></tr>
  {% endfor %}
{% endcall %}
{% endif %}
{# P1-11（§12）：缺失机制表 + MNAR 固定 WARNING（启发式，非严格因果推断） #}
{% if s.data.missingness and s.data.missingness.variables %}
{% set mz = s.data.missingness %}
{% call tbl("缺失数据机制（启发式判断，α=" ~ mz.alpha ~ "）") %}
  <tr><th>变量</th><th>缺失率</th><th>机制</th><th>关联变量</th><th>插补建议</th></tr>
  {% for v in mz.variables %}
  <tr><td>{{ v.column }}</td><td>{{ '%.1f%%' | format(v.missing_rate * 100) }}</td>
      <td>{{ {"likely_mcar": "Likely MCAR", "likely_mar": "Likely MAR", "possible_mnar": "Possible MNAR", "undetermined": "Undetermined"}[v.mechanism] }}</td>
      <td>{{ v.associated_variables | join("、") or "—" }}</td>
      <td>{{ v.imputation_advice }}</td></tr>
  {% endfor %}
{% endcall %}
{% for v in mz.variables %}{% if v.warning %}
<p class="meta" style="color:#b3001b;font-weight:bold;">{{ v.warning }}</p>
{% endif %}{% endfor %}
<p class="meta">缺失机制为启发式判断（非严格因果推断）；不静默插补——插补方法须在预处理配置中明确选择并由研究者确认。</p>
{% endif %}

{% elif s.key == "preprocessing" %}
{% call tbl("预处理步骤与参数") %}
  <tr><th>#</th><th>步骤</th><th>参数</th></tr>
  {% for step in s.data.steps %}
  <tr><td>{{ loop.index }}</td><td>{{ step.type }}</td>
      <td>{{ step.params_text }}</td></tr>
  {% endfor %}
{% endcall %}

{% elif s.key == "methods" %}
<p>任务类型：{{ s.data.task_type }}；模型：{{ s.data.selected_models | join("、") }}。</p>
{% if s.data.validation %}
<p>验证方案：{{ s.data.validation.strategy }}，n_splits={{ s.data.validation.n_splits }}，
   seed={{ s.data.validation.seed }}。</p>
{% endif %}

{% elif s.key == "performance" %}
{% call tbl("模型性能比较（mean±std）") %}
  <tr><th>模型</th><th>状态</th>
    {% set ns = namespace(names=[]) %}
    {% for row in s.data.table %}{% for k in (row.metrics or {}) %}
      {% if k not in ns.names %}{% set ns.names = ns.names + [k] %}{% endif %}
    {% endfor %}{% endfor %}
    {% for name in ns.names %}<th>{{ name }}</th>{% endfor %}
    {% if s.data.has_pvalues %}<th>p 值(vs 最佳)</th>{% endif %}
  </tr>
  {% for row in s.data.table %}
  <tr><td>{{ row.model_key }}</td><td>{{ row.status }}</td>
    {% for name in ns.names %}
      {% set cell = (row.metrics or {}).get(name) %}
      <td>{% if cell %}{{ '%.4f±%.4f' | format(cell.mean, cell.std) }}{% else %}—{% endif %}</td>
    {% endfor %}
    {% if s.data.has_pvalues %}<td>{{ row.p_value_text or "—" }}</td>{% endif %}
  </tr>
  {% endfor %}
{% endcall %}
{% if s.data.significance_note %}<p class="meta">{{ s.data.significance_note | replace("**", "") }}</p>{% endif %}
{% for g in s.data.guides %}
<div class="guide"><p><strong>{{ g.title }}</strong></p>
<p><strong>含义：</strong>{{ g.meaning }}</p>
<p><strong>判读规则：</strong>{{ g.rule }}</p>
{% if g.reading %}<p><strong>本数据：</strong>{{ g.reading }}</p>{% endif %}</div>
{% endfor %}
{% if s.data.llm_paragraph %}<p class="llm-paragraph">{{ s.data.llm_paragraph }}</p>{% endif %}
{% if s.data.calibration %}
{% set cal = s.data.calibration %}
{% if cal.hosmer_lemeshow and cal.hosmer_lemeshow.statistic is not none %}
<p>校准度检验（推荐模型 {{ cal.model_key }}，基于交叉验证 OOF 概率）：{{ cal.hosmer_lemeshow.conclusion }}</p>
{% endif %}
{% if cal.optimal_threshold and cal.optimal_threshold.threshold is not none %}
<p>{{ cal.optimal_threshold.interpretation }}</p>
{% endif %}
{% endif %}
{% if s.data.diagnostics %}
{% set d = s.data.diagnostics %}
<p><strong>回归诊断</strong>（推荐模型 {{ d.model_key }}，基于交叉验证 OOF 残差与预处理特征空间）：</p>
{% if d.coefficients %}
{% call tbl("OLS 回归系数（全量数据）") %}
  <tr><th>项</th><th>系数 β</th><th>95% CI</th><th>p 值</th></tr>
  {% for c in d.coefficients %}
  <tr><td>{{ c.term }}</td><td>{{ '%.4f' | format(c.coef) }}</td>
      <td>[{{ '%.4f' | format(c.ci_lower) }}, {{ '%.4f' | format(c.ci_upper) }}]</td>
      <td>{{ c.p_value | fmt_num }}</td></tr>
  {% endfor %}
{% endcall %}
{% endif %}
{% call tbl("回归假设诊断检验") %}
  <tr><th>检验</th><th>统计量</th><th>p 值</th><th>结论</th></tr>
  {% if d.shapiro and d.shapiro.statistic is not none %}
  <tr><td>残差正态性（{{ d.shapiro.test_name }}）</td><td>{{ '%.4f' | format(d.shapiro.statistic) }}</td>
      <td>{{ d.shapiro.p_value | fmt_num }}</td><td>{{ d.shapiro.conclusion }}</td></tr>
  {% endif %}
  {% if d.breusch_pagan and d.breusch_pagan.statistic is not none %}
  <tr><td>同方差性（Breusch-Pagan）</td><td>{{ '%.4f' | format(d.breusch_pagan.statistic) }}</td>
      <td>{{ d.breusch_pagan.p_value | fmt_num }}</td><td>{{ d.breusch_pagan.conclusion }}</td></tr>
  {% endif %}
  {% if d.durbin_watson and d.durbin_watson.statistic is not none %}
  <tr><td>自相关（Durbin-Watson）</td><td>{{ '%.3f' | format(d.durbin_watson.statistic) }}</td>
      <td>—</td><td>{{ d.durbin_watson.conclusion }}</td></tr>
  {% endif %}
{% endcall %}
{% if d.vif and d.vif.vif_values %}
{% call tbl("多重共线性（VIF）") %}
  <tr><th>特征</th><th>VIF</th></tr>
  {% for name, v in d.vif.vif_values.items() %}
  <tr><td>{{ name }}</td><td>{{ '%.2f' | format(v) if v is not none else "∞" }}</td></tr>
  {% endfor %}
{% endcall %}
{% if d.vif.conclusion %}<p class="meta">{{ d.vif.conclusion }}</p>{% endif %}
{% endif %}
{% endif %}
{% if s.data.survival_analysis %}
{% set sa = s.data.survival_analysis %}
{% if sa.at_risk %}
{% call tbl("风险集人数（Number at risk）") %}
  <tr><th>时间点</th>{% for t in sa.at_risk.times %}<th>{{ '%g' | format(t) }}</th>{% endfor %}</tr>
  <tr><td>风险集人数</td>{% for n in sa.at_risk.at_risk %}<td>{{ n }}</td>{% endfor %}</tr>
  <tr><td>累计事件数</td>{% for n in sa.at_risk.events_cum %}<td>{{ n }}</td>{% endfor %}</tr>
{% endcall %}
{% endif %}
{% if sa.logrank %}
<p>按推荐模型 {{ sa.logrank.model_key }} 的交叉验证风险中位数（{{ '%.4f' | format(sa.logrank.median_risk) }}）
   分层：高风险组 {{ sa.logrank.n_high }} 例、低风险组 {{ sa.logrank.n_low }} 例，
   log-rank 检验 χ²={{ '%.4f' | format(sa.logrank.statistic) }}，p={{ sa.logrank.p_value | fmt_num }}。</p>
{% endif %}
{% endif %}
{% for c in s.data.charts %}
  {% if c.image_b64 %}<img class="chart" src="data:image/png;base64,{{ c.image_b64 }}" alt="{{ c.title }}"/>
  {% else %}<p class="na">[图表] {{ c.title }}</p>{% endif %}
  <p class="fig-caption"><span class="fig-label">图 {{ c.fig_no }}　{{ c.title }}。</span>{{ c.caption }}</p>
{% endfor %}

{% elif s.key == "comparison" %}
<p>排名：{{ s.data.ranking | join(" > ") }}</p>
{% if s.data.llm_paragraph %}<p class="llm-paragraph">{{ s.data.llm_paragraph }}</p>{% endif %}
{% for t in s.data.top %}
<p><strong>Top{{ t.rank }} {{ t.model_key }}</strong>：{{ t.reason }}</p>
{% endfor %}
{% for n in s.data.not_recommended %}
<p>不推荐 {{ n.model_key }}：{{ n.reason }}</p>
{% endfor %}
{% if s.data.formula %}<p class="meta">排名公式披露：{{ s.data.formula }}</p>{% endif %}
{% if s.data.guide %}
<div class="guide"><p><strong>{{ s.data.guide.title }}</strong></p>
<p><strong>含义：</strong>{{ s.data.guide.meaning }}</p>
<p><strong>判读规则：</strong>{{ s.data.guide.rule }}</p>
{% if s.data.guide.reading %}<p><strong>本数据：</strong>{{ s.data.guide.reading }}</p>{% endif %}</div>
{% endif %}

{% elif s.key == "explainability" %}
{% for c in s.data.charts %}
  {% if c.image_b64 %}<img class="chart" src="data:image/png;base64,{{ c.image_b64 }}" alt="{{ c.title }}"/>
  {% else %}<p class="na">[图表] {{ c.title }}</p>{% endif %}
  <p class="fig-caption"><span class="fig-label">图 {{ c.fig_no }}　{{ c.title }}。</span>{{ c.caption }}</p>
{% endfor %}
{% for g in s.data.guides %}
<div class="guide"><p><strong>{{ g.title }}</strong></p>
<p><strong>含义：</strong>{{ g.meaning }}</p>
<p><strong>判读规则：</strong>{{ g.rule }}</p>
{% if g.reading %}<p><strong>本数据：</strong>{{ g.reading }}</p>{% endif %}</div>
{% endfor %}

{% elif s.key == "clinical_interpretation" %}
<p class="notice">{{ s.data.notice }}</p>
{% if s.data.llm_paragraph %}<p class="llm-paragraph">{{ s.data.llm_paragraph }}</p>{% endif %}
<ul>{% for st in s.data.statements %}<li>{{ st }}</li>{% endfor %}</ul>
{% for g in s.data.guides %}
<div class="guide"><p><strong>{{ g.title }}</strong></p>
<p><strong>含义：</strong>{{ g.meaning }}</p>
<p><strong>判读规则：</strong>{{ g.rule }}</p>
{% if g.reading %}<p><strong>本数据：</strong>{{ g.reading }}</p>{% endif %}</div>
{% endfor %}

{% elif s.key == "limitations" %}
<ul>{% for item in s.data["items"] %}<li>{{ item }}</li>{% endfor %}</ul>

{% elif s.key == "checklist" %}
<p class="meta">{{ s.data.standard }} —— 满足 {{ s.data.met }}/{{ s.data.total }} 项</p>
{% call tbl("报告规范自查") %}
  <tr><th>#</th><th>条目</th><th>状态</th><th>依据（真实产物核对）</th></tr>
  {% for i in s.data["items"] %}
  <tr><td>{{ i.no }}</td><td>{{ i.item }}</td>
      <td>{{ i.status }}</td><td>{{ i.evidence }}</td></tr>
  {% endfor %}
{% endcall %}
<p class="meta">{{ s.data.note }}</p>

{% elif s.key == "conclusion" %}
{% if s.data.red_flag %}<p class="red-flag"><strong>【结果可信度警示】</strong>{{ s.data.red_flag }}</p>{% endif %}
<p>{{ s.data.text }}</p>
{% endif %}
{% endfor %}

<h2>附录：可复现性信息</h2>
{% call tbl("可复现性参数") %}
  <tr><th>数据输入哈希</th><td><code>{{ appendix.input_hash or "—" }}</code></td></tr>
  <tr><th>预处理步骤数</th><td>{{ appendix.preprocess_steps | length }}</td></tr>
  {% if appendix.validation %}
  <tr><th>验证参数</th><td><code>{{ appendix.validation | tojson }}</code></td></tr>
  {% endif %}
{% endcall %}
{% call tbl("软件版本") %}
  <tr><th>软件</th><th>版本</th></tr>
  {% for name, ver in appendix.software.items() %}
  <tr><td>{{ name }}</td><td>{{ ver }}</td></tr>
  {% endfor %}
{% endcall %}
<p class="disclaimer">{{ appendix.disclaimer }}</p>
</body>
</html>
